# Copia este archivo como .env y cambia los valores. El .env NUNCA se sube a GitHub.
PORT=3000

# Conexión a MySQL (usa el usuario agendaya_app del final de agendaya_bd.sql, o root en desarrollo)
DB_HOST=localhost
DB_PORT=3306
DB_USER=agendaya_app
DB_PASSWORD=cambia_esta_clave
DB_NAME=agendaya

# Incremento 2: firma de los tokens del inicio de sesión (HU3). Pon una frase larga y secreta.
JWT_SECRETO=cambia_esta_frase_secreta_larga
JWT_DURACION=8h

# Origen permitido por CORS (el frontend de Vite en desarrollo)
ORIGEN_WEB=http://localhost:5173
